# Usuários do painel: usuario:salt:hash separados por vírgula. Gere cada um com `npm run senha -- <usuario>`.
DASHBOARD_USERS=
# Webhook do workflow "CNN Painel - Leitura" (URL de produção).
N8N_LEITURA_URL=
# Webhook do workflow "CNN Painel - Ações". Deixe vazio no ambiente Preview da Vercel.
N8N_ACOES_URL=
# Valor do header X-Monitor-Key (credencial Header Auth dos dois webhooks).
N8N_WEBHOOK_SECRET=
