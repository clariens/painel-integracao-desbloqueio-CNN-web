# Segredo que assina as sessões do painel (64 caracteres hex). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar o valor desloga todo mundo.
SESSION_SECRET=
# Webhook do workflow "CNN Painel - Leitura" (URL de produção).
N8N_LEITURA_URL=
# Webhook do workflow "CNN Painel - Ações". Deixe vazio no ambiente Preview da Vercel.
N8N_ACOES_URL=
# Webhook do workflow "CNN Painel - Usuários" (login e gestão de usuários).
N8N_USUARIOS_URL=
# Webhook do workflow "CNN Painel - Solicitações" (pedidos de desbloqueio).
N8N_SOLICITACOES_URL=
# Valor do header X-Monitor-Key (credencial Header Auth dos webhooks).
N8N_WEBHOOK_SECRET=
