{
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/pacientes/:id/:op(liberar|bloquear)", "destination": "/api/pacientes?id=:id&op=:op" },
    { "source": "/api/pacientes/:id", "destination": "/api/pacientes?id=:id" },
    { "source": "/api/solicitacoes/:id/liberar", "destination": "/api/solicitacoes?id=:id&op=liberar" },
    { "source": "/api/solicitacoes/:id", "destination": "/api/solicitacoes?id=:id" },
    { "source": "/api/usuarios/:login", "destination": "/api/usuarios?login=:login" },
    { "source": "/pacientes", "destination": "/index.html" },
    { "source": "/relatorios", "destination": "/relatorios.html" },
    { "source": "/historico", "destination": "/historico.html" },
    { "source": "/configuracao", "destination": "/configuracao.html" },
    { "source": "/usuarios", "destination": "/usuarios.html" },
    { "source": "/solicitacoes", "destination": "/solicitacoes.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
